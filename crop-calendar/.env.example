# Copy this file to .env and fill in the values from your local pgAdmin
# setup - see PGADMIN_SETUP.md for the exact steps. .env is gitignored,
# so your real password never gets committed.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=crop_calendar
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional: override the Flask session secret key for production use.
# FLASK_SECRET_KEY=change-me
